+use std::{
+    future::{poll_fn, Future},
+    pin::{pin, Pin},
+    sync::{Arc, Mutex},
+    task::{Context, Poll, Waker},
+};
+
+#[derive(Clone)]
+pub(super) struct Driver {
+    state: Arc<Mutex<State>>,
+}
+struct State {
+    connection: Option<Pin<Box<dyn Future<Output = ()> + Send>>>,
+    foreground: bool,
+    background: Option<Waker>,
+}
+
+impl Driver {
+    pub(super) fn new(connection: impl Future<Output = ()> + Send + 'static) -> Self {
+        Self {
+            state: Arc::new(Mutex::new(State {
+                connection: Some(Box::pin(connection)),
+                foreground: false,
+                background: None,
+            })),
+        }
+    }
+
+    fn claim(&self) -> Foreground {
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        // HTTP/1 pool reservations are exclusive; HTTP/2 never uses this driver.
+        assert!(!state.foreground, "HTTP/1 connection already in use");
+        state.foreground = true;
+        Foreground {
+            driver: self.clone(),
+        }
+    }
+
+    fn poll_connection(state: &mut State, cx: &mut Context<'_>) -> Poll<()> {
+        if let Some(connection) = &mut state.connection {
+            if connection.as_mut().poll(cx).is_pending() {
+                return Poll::Pending;
+            }
+        }
+        state.connection = None;
+        Poll::Ready(())
+    }
+}
+
+impl Future for Driver {
+    type Output = ();
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<()> {
+        let mut state = self.state.lock().unwrap_or_else(|e| e.into_inner());
+        // Foreground polling replaces the socket/dispatch waker even if the
+        // background task never ran while claimed. Keep its waker while idle
+        // too, so a partial response body always has a task to resume it.
+        if state
+            .background
+            .as_ref()
+            .is_none_or(|w| !w.will_wake(cx.waker()))
+        {
+            state.background = Some(cx.waker().clone());
+        }
+        if state.foreground {
+            Poll::Pending
+        } else {
+            Self::poll_connection(&mut state, cx)
+        }
+    }
+}
+
+struct Foreground {
+    driver: Driver,
+}
+impl Drop for Foreground {
+    fn drop(&mut self) {
+        let background = {
+            let mut state = self.driver.state.lock().unwrap_or_else(|e| e.into_inner());
+            state.foreground = false;
+            state.background.clone()
+        };
+        // Both completion and cancellation hand unread body/idle I/O back to the
+        // background task, which must re-register its own socket waker.
+        if let Some(waker) = background {
+            waker.wake();
+        }
+    }
+}
+
+pub(super) async fn drive<F: Future>(driver: Option<Driver>, future: F) -> F::Output {
+    let mut future = pin!(future);
+    let Some(driver) = driver else {
+        return future.await;
+    };
+    let _foreground = driver.claim();
+    poll_fn(|cx| {
+        if let Poll::Ready(result) = future.as_mut().poll(cx) {
+            return Poll::Ready(result);
+        }
+        {
+            let mut state = driver.state.lock().unwrap_or_else(|e| e.into_inner());
+            let _ = Driver::poll_connection(&mut state, cx);
+        }
+        future.as_mut().poll(cx)
+    })
+    .await
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicU8, Ordering};
+
+    #[tokio::test]
+    async fn completion_and_cancellation_resume_an_idle_driver() {
+        for cancel in [false, true] {
+            let ready = Arc::new(AtomicU8::new(0));
+            let state = ready.clone();
+            let (started, idle) = tokio::sync::oneshot::channel();
+            let (headers, response) = tokio::sync::oneshot::channel();
+            let (body, received) = tokio::sync::oneshot::channel();
+            let (mut started, mut headers, mut body) = (Some(started), Some(headers), Some(body));
+            let driver = Driver::new(poll_fn(move |_| {
+                if let Some(started) = started.take() {
+                    let _ = started.send(());
+                }
+                match state.load(Ordering::Relaxed) {
+                    1 => {
+                        if let Some(headers) = headers.take() {
+                            let _ = headers.send(());
+                        }
+                        Poll::Pending
+                    }
+                    2 => {
+                        if let Some(body) = body.take() {
+                            let _ = body.send(());
+                        }
+                        Poll::Ready(())
+                    }
+                    _ => Poll::Pending,
+                }
+            }));
+            let background = tokio::spawn(driver.clone());
+            idle.await.unwrap();
+            // Readiness can be consumed by the foreground without the idle task
+            // getting another poll. Its own waker must survive this takeover.
+            ready.store(1, Ordering::Relaxed);
+            if cancel {
+                let mut request = Box::pin(drive(Some(driver), std::future::pending::<()>()));
+                poll_fn(|cx| {
+                    assert!(request.as_mut().poll(cx).is_pending());
+                    Poll::Ready(())
+                })
+                .await;
+                drop(request);
+            } else {
+                drive(Some(driver), response).await.unwrap();
+            }
+            ready.store(2, Ordering::Relaxed);
+            tokio::time::timeout(std::time::Duration::from_secs(1), received)
+                .await
+                .unwrap()
+                .unwrap();
+            background.await.unwrap();
+        }
+    }
+}
