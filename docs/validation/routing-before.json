  "assessment": [
    {
      "priority": "P1",
      "finding": "Ingress defaultBackend overrides an explicit hostless Prefix / rule",
      "code": "src/ingress/mod.rs:465",
      "evidence": "ingress[0]",
      "expected": "Explicit rules take precedence; defaultBackend handles unmatched requests."
    },
    {
      "priority": "P2",
      "finding": "req.set_query changes original path escaping and normalization",
      "code": "src/proxy/mod.rs:332",
      "evidence": "http.query_edit",
      "expected": "Without an explicit path rewrite or proxy_pass URI, preserve the original path while replacing query."
    },
    {
      "priority": "P2",
      "finding": "Missing or invalid HTTP/1.1 Host reaches the default backend",
      "code": "src/proxy/mod.rs:142",
      "evidence": [
        "http.missing_host",
        "http.invalid_host"
      ],
      "expected": "Return 400 before routing; preserve valid HTTP/1.0 and unknown-host behavior."
    },
    {
      "priority": "P2",
      "finding": "Upstream response timeout returns 502 instead of 504",
      "code": "src/proxy/mod.rs:419",
      "evidence": "http.read_timeout",
      "expected": "Distinguish gateway timeout from other upstream failures."
    }
  ],
  "hardening_observation": {
    "finding": "Recreated Service can route to stale EndpointSlices owned by the previous Service UID",
    "code": "src/ingress/mod.rs:662",
    "evidence": [
      "ingress[3]",
      "ingress[4]"
    ],
    "classification": "Observed isolation risk, not asserted to violate Kubernetes conformance: EndpointSlice API associates by service-name label.",
    "recommendation": "Consider ignoring a conflicting Service owner UID while retaining support for manually managed slices without such an owner; include owner references in the resource fingerprint if enforcing this."
  },
