  "source_sha256": "a56ff850f72bd88abd8c27bed699dca101ecb85b4a31ad4f04f2cd0540e6300f",
  "environment": "OrbStack Ubuntu Linux arm64; NGINX 1.28.0; isolated local Kubernetes API fixture",
  "production_source_changed": false,
  "existing_kubernetes_resources_changed": false,
  "findings": [
    {
      "priority": "P1",
      "finding": "RGL selection of a named HTTPS upstream silently uses its plaintext backend",
      "trigger": "proxy_pass https://localhost/ plus return route.proxy(\"localhost\")",
      "actual": "pass uses TLS and returns 200; proxy sends plaintext HTTP including the test Authorization field and returns 502",
      "code": [
        "src/config/mod.rs:103",
        "src/config/mod.rs:341",
        "src/proxy/mod.rs:241"
      ],
      "evidence": "plugin selects the same HTTPS upstream",
      "recommendation": "Bind script backend aliases to an explicit transport and TLS validation policy; reject ambiguous mappings rather than silently downgrading."
    },
    {
      "priority": "P2",
      "finding": "Action consistency validation cannot distinguish two decisions of the same kind",
      "trigger": "local first=route.proxy(\"app\"); local second=route.proxy(\"alternate\"); return first",
      "actual": "Returns 200 from alternate; returning the earlier action does not select app or raise an inconsistency error",
      "code": [
        "src/script/mod.rs:273",
        "src/script/mod.rs:490"
      ],
      "evidence": "return first of two proxy actions",
      "recommendation": "Give action values a decision identity, or reject a returned action superseded by another decision."
    },
    {
      "priority": "P2",
      "finding": "A stalled Ingress GET prevents other namespaces from receiving updated status addresses",
      "trigger": "Delay the first Ingress GET by 8 seconds, then change publish Service address",
      "actual": "After three stalled GET attempts both Ingress addresses remain 192.0.2.10 instead of 192.0.2.11; Lease renewals and HTTP forwarding continue. Removing the delay restores both addresses.",
      "code": [
        "src/ingress/status.rs:45",
        "src/ingress/status.rs:198"
      ],
      "evidence": "slow Ingress GET blocks another namespace status",
      "recommendation": "Bound concurrent per-Ingress work and isolate each request timeout/error, so each reporting cycle can progress beyond the first stalled object."
    },
    {
      "priority": "P2",
      "finding": "Automatic trailing-slash redirects use response settings from the wrong location",
      "trigger": "location /slash/ has add_header X-Scope slash; parent has X-Scope root; request /slash",
      "actual": "Both return 301, but rgnix emits X-Scope root and NGINX emits X-Scope slash",
      "code": [
        "src/proxy/mod.rs:175",
        "src/proxy/mod.rs:189"
      ],
      "evidence": "slash redirect location headers",
      "recommendation": "Use the matched trailing-slash location for redirect response settings and request context."
    },
    {
      "priority": "P2",
      "finding": "If-Range date validator accepts nonmatching newer timestamps",
      "trigger": "File Last-Modified is 2023-11-14; Range bytes=2-4 with If-Range 2024-01-02",
      "actual": "rgnix returns 206 and 3 bytes; NGINX returns 200 and the full 10-byte file",
      "code": [
        "src/proxy/responses.rs:175"
      ],
      "evidence": "If-Range different newer timestamp",
      "recommendation": "Compare If-Range dates for exact equality to Last-Modified instead of using <=.",
      "reference": "https://www.rfc-editor.org/rfc/rfc9110.html#section-13.1.5"
    },
    {
      "priority": "P2",
      "finding": "The host variable lacks the selected server-name fallback",
      "trigger": "HTTP/1.0 without Host, with proxy_set_header Host $host",
      "actual": "rgnix omits upstream Host and receives 400 from a backend requiring Host; NGINX uses example.test and receives 200",
      "code": [
        "src/proxy/mod.rs:637",
        "src/proxy/mod.rs:350"
      ],
      "evidence": "HTTP/1.0 request to an upstream requiring Host",
      "recommendation": "Resolve $host using the selected virtual host when the incoming request has no authority; keep $http_host as the original field.",
      "reference": "https://nginx.org/en/docs/http/ngx_http_core_module.html#var_host"
    }
  ],
